        "tip": "Keep the retroflex place: ट/ठ are made with the tongue tip curled up."
      }
    ],
    "ʈʰ": [
      {
        "diagnosed": "tʰ",
        "tip": "You used dental /tʰ/. Retroflex ठ curls the tongue tip back and puffs air."
      }
    ],
    "ɖʱ": [
      {
        "diagnosed": "dʰ",
        "tip": "You used dental /dʰ/. Nepali ढ is retroflex-breathy — curl the tongue back."
      }
    ],
    "dʒ": [
      {
        "diagnosed": "z",
        "tip": "You said /z/. Nepali ज is /dʒ/ — a full stop plus buzz (जान्छु)."
      }
    ],
    "bʱ": [
      {
        "diagnosed": "b",
        "tip": "You dropped the breath. भ is breathy /bʱ/ — voice plus an h-like escape (भात, भयो)."
      }
    ],
    "tʃʰ": [
      {
        "diagnosed": "ʃ",
        "tip": "You said /ʃ/ alone. Nepali छ has a stop onset: /tʃʰ/ (छ, छन्)."
      },
      {
        "diagnosed": "s",
        "tip": "You said /s/. Start छ with a t-stop then aspirated ʃ."
      }
    ],
    "ŋ": [
      {
        "diagnosed": "n",
        "tip": "You said /n/. In सँगै/सङ्गै the nasal is the back /ŋ/."
      }
    ],
    "a": [
      {
        "diagnosed": "ə",
        "tip": "Nepali inherent vowel is /a/ (अ = [ə]–[a]) — open it up, don't reduce to schwa."
      }
    ],
    "b": [
      {
        "diagnosed": "bʰ",
        "tip": "Plain ब is /b/ without breath — keep the voicing tight (बजार)."
      }
    ]
